# Environment for the Dokploy application. Paste into the application's "Environment" tab.
# Copy this file to deploy/dokploy.env (git-ignored) and fill in the secrets; never commit real values.

# From the Dokploy PostgreSQL service ("Internal Connection URL"); it only works inside Dokploy's network.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Signs login tokens. At least 32 random characters; changing it signs everyone out.
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=8h

# The public address of the app (HTTPS), exactly as users type it.
CORS_ORIGIN=https://verdant.divine.co.id

# One reverse proxy (Traefik) sits in front of the app, so login rate limiting can see real client addresses.
TRUST_PROXY=1

# First start only: create this admin (an existing account is never changed) and load the starter ESG catalog.
SEED_ON_START=true
SEED_CATALOG=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME

# Optional real email delivery (otherwise notifications are only written to the log)
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#MAIL_FROM="Verdant <no-reply@divine.co.id>"
