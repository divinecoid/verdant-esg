{
  "name": "esg-monitoring",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w @esg/api",
    "dev:web": "npm run dev -w @esg/web",
    "build": "npm run build -w @esg/api && npm run build -w @esg/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run prisma:migrate -w @esg/api",
    "db:seed": "npm run prisma:seed -w @esg/api",
    "db:seed:catalog": "npm run prisma:seed:catalog -w @esg/api"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "multer": "^2.5.0",
    "uuid": "^11.1.1"
  }
}
